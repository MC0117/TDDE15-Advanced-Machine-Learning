sigmaNoise <- var(fit$residuals)
kern_20_100 <- SEkernelKL(sigmaf = 20, ell=100)
GPfit <- gausspr(time, temp, kernel=kern_20_100, var= sigmaNoise, variance.model=TRUE, scaled=FALSE)
meanPred <- predict(GPfit, time)
